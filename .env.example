# APP CONFIG
APP_NAME="AlumniLink"
APP_URL="http://localhost/alumnilink"
APP_ENV="local" # local or production

# Zona waktu untuk PHP DAN sesi MySQL sekaligus. Kosongkan untuk memakai
# Asia/Jakarta.
#
# Jangan menyerahkannya ke php.ini. Sebelum baris ini ada, PHP mengikuti
# php.ini dan MySQL mengikuti jam sistemnya sendiri; di produksi keduanya
# terpaut tujuh jam (PHP UTC, basis data WIB, dua mesin berbeda). Selisih
# itu tidak memunculkan galat apa pun — ia hanya membuat tautan atur-ulang
# sandi berlaku 8 jam alih-alih 1 jam, dan umur SLA menjadi negatif.
APP_TIMEZONE="Asia/Jakarta"

# DATABASE CONFIG
DB_HOST="localhost"
DB_NAME="alumnilink"
DB_USER="root"
DB_PASS=""

# MIDTRANS CONFIG (Get these from Midtrans Dashboard)
MIDTRANS_SERVER_KEY="YOUR_SERVER_KEY"
MIDTRANS_CLIENT_KEY="YOUR_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION=false

# INSTITUTION CONFIG
INSTITUTION_NAME="FK UMS"

# SMTP MAIL CONFIG (Required for production forgot password functionality)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-smtp-password-or-api-key"
SMTP_SECURE="tls" # tls or ssl
SMTP_FROM_EMAIL="no-reply@domain.com"
SMTP_FROM_NAME="AlumniLink FK UMS"
